# --- Citely project ---
node_modules/
.env
.DS_Store
# No trailing slash on .venv/data: on this machine both are SYMLINKS pointing
# outside ~/Documents (macOS iCloud "Optimize Storage" was evicting their
# contents, which hung Python imports and broke Docker bind mounts with
# EDEADLK). Git treats a symlink as a file, so a "dir/" pattern would NOT
# match it and the link would get committed as a broken machine-specific path.
.venv
.venv*/
venv/
__pycache__/
**/__pycache__/
**/*.pyc
.vscode/
data
*.pdf
# One tiny synthetic PDF the viewer tests need (generated by make_sample.py); no real documents.
!Citely-Modernist-Next-Final/tests/fixtures/pdf/sample.pdf
RG=*.yml

# Generated cross-project reference notes (not part of this app; scratch
# output for carrying design decisions into a future project).
RAG_PIPELINE_FOUNDATION.txt
REUSABLE_FOUNDATION.txt

# Needed files the template rules above would hide
!.env.docker
!Citely-Modernist-Next-Final/vendor/xlsx-0.20.3.tgz
